      "name": "The Red Hands",
      "brief": "A bandit band that takes a toll at the bridges",
      "stat_block_id": "bandit"
    },
    {
      "name": "The Grey Chapel",
      "brief": "A secret cult that searches the ruins for an old relic",
      "stat_block_id": "cultist"
    }
  ],

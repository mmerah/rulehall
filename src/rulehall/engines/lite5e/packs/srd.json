  "locations": [
    {
      "name": "Harrowford",
      "brief": "A walled market town at a river ford, with a temple, an inn and a smithy.",
      "encounters": "merchants, town guards, an acolyte of the temple, pickpockets on market day"
    },
    {
      "name": "The King's Road",
      "brief": "An old paved road between the towns. Its milestones and its bridges are failing.",
      "encounters": "caravans, drovers, bandits at the bridges, wolves at night"
    },
    {
      "name": "Greywood",
      "brief": "A dark old forest of oak and pine east of the road.",
      "encounters": "trappers, wolves, giant spiders, goblins in the deep wood"
    },
    {
      "name": "Fort Corran",
      "brief": "A ruined hill fort of the old kingdom. Its vaults go deep under the hill.",
      "encounters": "skeletons, zombies, treasure hunters, a hidden cult"
    },
    {
      "name": "The Northern Downs",
      "brief": "Open hills and moor above the last farms. Raiders cross them from the north.",
      "encounters": "orc raiders, shepherds, an owlbear, a lost patrol"
    }
  ],
  "seeds": [
    "A caravan is three days late, and its last camp is burned.",
    "The ferryman of Harrowford asks for help: something drowns his cattle at the ford.",
    "A farmer finds an old iron door in his field after a storm.",
    "The temple bell of Harrowford rings at midnight, and nobody is in the tower.",
    "Orc raiders take a miller's children north across the downs.",
    "A merchant pays well for a sealed box from the vaults of Fort Corran.",
    "The town watch hires guards to hold a bridge against bandits for one night.",
    "A trapper comes back from Greywood with a goblin arrow in his back and a strange map.",
    "A noble's heir runs away to join a band of outlaws.",
    "The dead in the old graveyard do not stay in their graves.",
    "A sick traveler at the inn carries a letter for a lord who died last year.",
    "A wolf pack follows a pilgrim band along the King's Road."
  ],
  "factions": [
    {
      "name": "The Road Wardens",
      "brief": "The town watches together, paid to keep the King's Road open",
      "stat_block_id": "guard"
    },

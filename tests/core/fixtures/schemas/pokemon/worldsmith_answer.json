{
  "additionalProperties": false,
  "properties": {
    "places": {
      "patternProperties": {
        "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "brief": {
              "type": "string"
            },
            "known": {
              "default": false,
              "type": "boolean"
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "brief",
            "description"
          ],
          "type": "object"
        }
      },
      "propertyNames": {},
      "type": "object"
    },
    "ways": {
      "patternProperties": {
        "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
          "items": {
            "additionalProperties": false,
            "description": "One way out, in one direction, from the place it is filed under.",
            "properties": {
              "to_id": {
                "type": "string"
              },
              "known": {
                "default": true,
                "description": "False only for a secret way the story must find.",
                "type": "boolean"
              },
              "locked": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "to_id"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "propertyNames": {},
      "type": "object"
    },
    "npcs": {
      "patternProperties": {
        "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "brief": {
              "type": "string"
            },
            "known": {
              "default": false,
              "type": "boolean"
            },
            "voice": {
              "description": "How this person sounds read aloud: feminine, masculine, or other for creatures, machines and voices that are neither.",
              "enum": [
                "feminine",
                "masculine",
                "other"
              ],
              "type": "string"
            },
            "place_id": {
              "type": "string"
            },
            "roster": {
              "default": [],
              "description": "The Pokemon this person battles with, as species and level. Empty for a person who does not battle.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "species_id": {
                    "description": "A species id from SPECIES.",
                    "type": "string"
                  },
                  "level": {
                    "description": "Its level.",
                    "maximum": 100,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "species_id",
                  "level"
                ],
                "type": "object"
              },
              "maxItems": 6,
              "type": "array"
            },
            "badge": {
              "default": "",
              "description": "The badge this trainer gives when beaten, such as a gym leader's. Empty for most trainers.",
              "type": "string"
            },
            "style": {
              "default": "",
              "description": "One line on how this key trainer (a gym leader, the rival, an operation's leader or the team's boss) battles, such as 'sets up rain, then sweeps'. Empty for anyone else.",
              "type": "string"
            },
            "trial": {
              "default": "",
              "description": "One sentence, only for a gym leader: the trial the challenger meets before the leader, such as a maze, a quiz or a puzzle a Pokemon solves. Empty for anyone else.",
              "type": "string"
            },
            "win_line": {
              "default": "",
              "description": "What this key trainer (a gym leader, the rival, an operation's leader or the team's boss) says on beating the player. Empty for anyone else.",
              "type": "string"
            },
            "lose_line": {
              "default": "",
              "description": "What this key trainer (a gym leader, the rival, an operation's leader or the team's boss) says when the player beats them. Empty for anyone else.",
              "type": "string"
            },
            "rival": {
              "default": false,
              "description": "True for the one rival of the story, who stands in the opening map. A rival has no `roster`: code builds their team at each battle.",
              "type": "boolean"
            },
            "double": {
              "default": false,
              "description": "True for a trainer who always battles two-on-two, such as twins, a pair or a gym that fights in doubles. Needs a `roster` of at least two.",
              "type": "boolean"
            },
            "avatar_id": {
              "description": "How this person looks: exact id from TRAINER CLASSES.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "brief",
            "voice",
            "place_id",
            "avatar_id"
          ],
          "type": "object"
        }
      },
      "propertyNames": {},
      "type": "object"
    },
    "items": {
      "patternProperties": {
        "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "brief": {
              "type": "string"
            },
            "known": {
              "default": false,
              "type": "boolean"
            },
            "holder_id": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "brief",
            "holder_id"
          ],
          "type": "object"
        }
      },
      "propertyNames": {},
      "type": "object"
    },
    "arc": {
      "default": "",
      "description": "The truth behind this map: secrets, what can come, and what ties one hidden thing to another. The player never reads it.",
      "type": "string"
    },
    "start_id": {
      "description": "Exact id of the place this map starts from.",
      "type": "string"
    },
    "recap": {
      "description": "One paragraph on the part of the map the player leaves behind: what the player did there, paid and learned. The narrator reads it. Name nothing hidden.",
      "type": "string"
    },
    "wild": {
      "description": "The wild table of each new place, keyed by place id. A town or a building has no table.",
      "patternProperties": {
        "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "species_id": {
                "description": "A species id from SPECIES.",
                "type": "string"
              },
              "lowest": {
                "description": "The lowest level it has here.",
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              },
              "highest": {
                "description": "The highest level it has here.",
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              },
              "weight": {
                "description": "How often it shows up, against the other rows.",
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "species_id",
              "lowest",
              "highest",
              "weight"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "propertyNames": {},
      "type": "object"
    },
    "center_place_ids": {
      "default": [],
      "description": "Ids of the places of this map that are a Pokemon Center, where the team heals. One in every town.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "operation": {
      "additionalProperties": false,
      "properties": {
        "place_id": {
          "description": "Exact id of the place of this map where the team works. The map's start reaches it without a lock.",
          "type": "string"
        },
        "leader_id": {
          "description": "Exact id of its leader: a person of this map with a roster and no badge, or an earlier leader that THE SCHEME names.",
          "type": "string"
        },
        "goal": {
          "description": "What the team does there.",
          "type": "string"
        }
      },
      "required": [
        "place_id",
        "leader_id",
        "goal"
      ],
      "type": [
        "object",
        "null"
      ],
      "default": null,
      "description": "The evil team's operation in this map. Write it only when the request asks for it; else null."
    },
    "boss_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Exact id of the evil team's boss, a person of this map. Write it only when the request asks for the lair; else null."
    }
  },
  "required": [
    "start_id",
    "recap"
  ],
  "type": "object"
}

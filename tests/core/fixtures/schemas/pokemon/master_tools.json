  {
    "name": "direct",
    "description": "Call this last, once per turn. It ends the turn and gives notes to the narrator. Include the answer or result, its known reason, and facts needed for the next choice. Share only facts the player can know now. Use reveal first for hidden entities. Apply world changes through the other tools before calling direct.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "description": "Brief factual notes for the narrator to phrase. Answer each question in the player action. Include the result, its known reason, and details needed for the next choice. For a request or warning, give what the person wants and the reason they share. Use facts the player can know now. Identify claims and unknown reasons as such. Keep every outcome consistent with tool results.",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    }
  },
  {
    "name": "move_item",
    "description": "Move an item to a new holder.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "description": "Exact id of an item here or carried.",
          "type": "string"
        },
        "to_id": {
          "description": "Exact id of the player, an npc here, or this place.",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "to_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "unlock_way",
    "description": "Open a locked way out of this place.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "to_id": {
          "description": "Exact id of the locked way's destination.",
          "type": "string"
        }
      },
      "required": [
        "to_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "move",
    "description": "Move the player through an unlocked way out of this place.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "to_id": {
          "description": "Exact id of the place to move to.",
          "type": "string"
        },
        "with_ids": {
          "default": [],
          "description": "Exact ids of living npcs here who follow one time. Party members come without this field.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "to_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "meanwhile",
    "description": "Time passes where the player is not. Move a dweller, move a loose item, and shut a way the player knows. Use any combination in one call. Call this only while ELSEWHERE is shown.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "dweller_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Exact id of a dweller elsewhere who walks to a new place."
        },
        "dweller_to_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Exact id of the place the dweller walks to."
        },
        "item_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Exact id of a loose item elsewhere that moves to a new place."
        },
        "item_to_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Exact id of the place the item moves to."
        },
        "shut_from_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Exact id of one end of the way that shuts."
        },
        "shut_to_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Exact id of the other end of the way that shuts."
        }
      },
      "type": "object"
    }
  },
  {
    "name": "join_party",
    "description": "Make a person here travel with the player.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "description": "Exact id of who is joining.",
          "type": "string"
        }
      },
      "required": [
        "target_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "check",
    "description": "Call this when the player tries something hard outside a battle. The engine rolls d20, adds twice the skill rank and 2 for a helping Pokemon, and compares the total with the difficulty. You decide what a failure costs.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "what": {
          "description": "The attempt, in a few words the player reads.",
          "type": "string"
        },
        "skill": {
          "description": "The skill the player uses.",
          "enum": [
            "athletics",
            "stealth",
            "perception",
            "nature",
            "lore",
            "charm"
          ],
          "type": "string"
        },
        "difficulty": {
          "description": "easy is DC 10, hard is DC 15, very-hard is DC 20.",
          "enum": [
            "easy",
            "hard",
            "very-hard"
          ],
          "type": "string"
        },
        "helper_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Exact id of a team Pokemon that helps. It must not be fainted. Null when none helps."
        },
        "reason": {
          "default": "",
          "description": "How the helper helps, such as 'Geodude breaks the rock'. The player reads it. Empty with no helper.",
          "type": "string"
        }
      },
      "required": [
        "what",
        "skill",
        "difficulty"
      ],
      "type": "object"
    }
  },
